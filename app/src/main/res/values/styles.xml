<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Preference" parent="Theme.Preference.Light" />

    <style name="Theme.Preference.Light.Base" parent="Theme.Material3.DynamicColors.Light.NoActionBar"/>
    <style name="Theme.Preference.Light.v23" parent="Theme.Preference.Light.Base"/>
    <style name="Theme.Preference.Light.v21" parent="Theme.Preference.Light.v23"/>
    <style name="Theme.Preference.Light" parent="Theme.Preference.Light.v21">
        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryLight</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainerLight</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainerLight</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorSurface">@color/colorSurfaceLight</item>
        <item name="colorOnSurface">@color/colorOnSurfaceLight</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainerLight</item>
        <item name="colorSecondary">@color/colorSecondaryLight</item>
        <item name="colorOnSecondary">@color/colorOnSecondaryLight</item>
        <item name='android:windowBackground'>@color/colorSurfaceLight</item>
        <!-- Preference -->
        <item name="preferenceTheme">@style/Style.Preference.v21</item>
        <item name="preferenceStyle">@style/Style.Preference.Style</item>
        <item name="dialogPreferenceStyle">@style/Style.Preference.Dialog.Style</item>
        <item name="preferenceCategoryStyle">@style/Style.Preference.Category.Style</item>
        <!-- Switch -->
        <item name="android:switchPreferenceStyle">@style/Style.SwitchPreference</item>
        <item name="switchPreferenceStyle">@style/Style.SwitchPreference</item>
        <item name="switchPreferenceCompatStyle">@style/Style.SwitchPreference</item>
        <!-- Dialog -->
        <item name="android:alertDialogTheme">@style/Style.Dialog</item>
        <item name="alertDialogTheme">@style/Style.Dialog</item>
    </style>

    <style name="Theme.Preference.Night.Base" parent="Theme.Material3.DynamicColors.Dark.NoActionBar"/>
    <style name="Theme.Preference.Night.v23" parent="Theme.Preference.Night.Base"/>
    <style name="Theme.Preference.Night.v21" parent="Theme.Preference.Night.v23"/>
    <style name="Theme.Preference.Night" parent="Theme.Preference.Night.v21">
        <item name="colorPrimary">@color/colorPrimaryNight</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryNight</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorSurface">@color/colorSurfaceNight</item>
        <item name="colorOnSurface">@color/colorOnSurfaceNight</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainerNight</item>
        <item name="colorSecondary">@color/colorSecondaryNight</item>
        <item name="colorOnSecondary">@color/colorOnSecondaryNight</item>
        <item name='android:windowBackground'>@color/colorSurfaceNight</item>
        <!-- Preference -->
        <item name="preferenceTheme">@style/Style.Preference.v21</item>
        <item name="preferenceStyle">@style/Style.Preference.Style</item>
        <item name="dialogPreferenceStyle">@style/Style.Preference.Dialog.Style</item>
        <item name="preferenceCategoryStyle">@style/Style.Preference.Category.Style</item>
        <!-- Switch -->
        <item name="android:switchPreferenceStyle">@style/Style.SwitchPreference</item>
        <item name="switchPreferenceStyle">@style/Style.SwitchPreference</item>
        <item name="switchPreferenceCompatStyle">@style/Style.SwitchPreference</item>
        <!-- Dialog -->
        <item name="android:alertDialogTheme">@style/Style.Dialog</item>
        <item name="alertDialogTheme">@style/Style.Dialog</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Style.Preference.v21" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="android:tint">@color/colorPrimaryLight</item>
    </style>
    <style name="Style.Preference.Style" parent="@style/Preference.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Style.Preference.Dialog.Style" parent="@style/Preference.DialogPreference.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Style.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="dialogCornerRadius">24dp</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>
    <style name="Style.Preference.Category.Style" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/style_preference_category_material</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Style.SwitchPreference" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/style_preference_material_switch</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
</resources>